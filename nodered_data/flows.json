    {
        "id": "dccbf8f5950304c2",
        "type": "function",
        "z": "cc01fd911caf8788",
        "name": "function 1",
        "func": "// 1. Convertim el missatge en un objecte JSON\nvar d = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\n// 2. EXTRACCIÓ CORREGIDA: Com que no hi ha barra inicial, la MAC és la posició 0\nvar parts = msg.topic.split('/');\nvar mac = parts[0] || 'UNKNOWN';\n\n// 3. Generem el timestamp actual (UTC+2 Espanya)\nvar now = new Date();\nnow.setHours(now.getHours() + 2);\nvar ts = now.toISOString().slice(0, 19).replace('T', ' ');\n\n// 4. Assegurem els valors extrets de la VirKo (suportant majúscules i minúscules)\nvar temperatura = (d.T !== undefined) ? d.T : ((d.temp !== undefined) ? d.temp : 0);\nvar co2         = (d.CO2_ppm !== undefined) ? d.CO2_ppm : ((d.co2 !== undefined) ? d.co2 : 0);\nvar humitat     = (d.RH !== undefined) ? d.RH : ((d.rh !== undefined) ? d.rh : 0);\nvar pressio     = (d.P !== undefined) ? d.P : ((d.p !== undefined) ? d.p : 0);\nvar ldr         = (d.LDR !== undefined) ? d.LDR : ((d.ldr !== undefined) ? d.ldr : 0);\nvar iaq         = (d.IAQ !== undefined) ? d.IAQ : ((d.iaq !== undefined) ? d.iaq : 0);\n\n// 5. Missatge per a la Sortida 1: Taula 'dades'\nvar msgDades = {\n    payload: { temp: temperatura, rh: humitat, p: pressio, co2: co2, ldr: ldr, iaq: iaq, mac: mac },\n    topic: `INSERT INTO dades (timestamp, ldr, co2, temp, pressio, humitat, iaq, mac) VALUES ('${ts}', '${ldr}', '${co2}', '${temperatura}', '${pressio}', '${humitat}', '${iaq}', '${mac}')`\n};\n\n// 6. Missatge per a la Sortida 2: Taula 'fulls' (Registra l'aula si no existeix)\nvar msgFulls = {\n    topic: `INSERT IGNORE INTO fulls (mac, nom, rol) VALUES ('${mac}', 'IoT-02 Bessos', 'R')`\n};\n\n// 7. Retornem cada missatge pel seu cable corresponent (Funció configurada amb 2 sortides)\nreturn [msgDades, msgFulls];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
