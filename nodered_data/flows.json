    {
        "id": "dccbf8f5950304c2",
        "type": "function",
        "z": "cc01fd911caf8788",
        "name": "function 1",
        "func": "var d = (typeof msg.payload === 'string') ? JSON.parse(msg.payload) : msg.payload;\n\n// Ignorar missatges que no tinguin dades de sensors\nif (!d.T && !d.temp) return null;\n\nvar parts = msg.topic.split('/');\nvar mac = parts[1] || 'UNKNOWN';\nvar now = new Date();\nnow.setHours(now.getHours() + 2);\nvar ts = now.toISOString().slice(0, 19).replace('T', ' ');\n\nmsg.payload = {\n    temp: d.T || d.temp || 0,\n    rh: d.RH || d.rh || 0,\n    p: d.P || d.p || 0,\n    co2: d.CO2_ppm || d.co2 || 0,\n    ldr: d.LDR || d.ldr || 0,\n    iaq: d.IAQ || d.iaq || 0,\n    mac: mac\n};\n\nvar msgFulls = {\n    topic: `INSERT IGNORE INTO fulls (mac, nom, rol) VALUES ('${mac}', 'IoT-02 Bessos', 'R')`\n};\n\nmsg.topic = `INSERT INTO dades (timestamp, ldr, co2, temp, pressio, humitat, iaq, mac) \n             VALUES ('${ts}', '${d.LDR||0}', '${d.CO2_ppm||0}', '${d.T||0}', '${d.P||0}', '${d.RH||0}', '${d.IAQ||0}', '${mac}')`;\n\nreturn [msg, msgFulls, msg, msg, msg, msg, msg, msg];",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 680,
        "y": 420,
        "wires": [
            [
                "eb485d5e6eb5bfcd"
            ]
        ]
    },
